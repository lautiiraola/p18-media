{
 "idioma": "es",
 "frases": [
  {
   "ini": 0.0,
   "fin": 1.1,
   "texto": "¿Por qué debería haber empezado?"
  },
  {
   "ini": 2.8,
   "fin": 4.58,
   "texto": "Porque he hecho algo erróneo,"
  },
  {
   "ini": 4.58,
   "fin": 6.16,
   "texto": "entre comillas, que es casi"
  },
  {
   "ini": 6.16,
   "fin": 6.92,
   "texto": "dejarlo para el final."
  },
  {
   "ini": 7.6,
   "fin": 8.96,
   "texto": "Y muchas veces es mejor empezar"
  },
  {
   "ini": 8.96,
   "fin": 11.24,
   "texto": "por el ahorro para evitarnos"
  },
  {
   "ini": 11.24,
   "fin": 14.18,
   "texto": "no hacerlo."
  },
  {
   "ini": 14.18,
   "fin": 15.6,
   "texto": "Porque si tú empiezas a reinar"
  },
  {
   "ini": 15.6,
   "fin": 17.02,
   "texto": "sobres, de repente se acaba y ni"
  },
  {
   "ini": 17.02,
   "fin": 18.84,
   "texto": "ahorras, ni inviertes,"
  },
  {
   "ini": 18.84,
   "fin": 19.7,
   "texto": "ni haces nada."
  },
  {
   "ini": 19.7,
   "fin": 21.34,
   "texto": "Y entonces vas viviendo al día,"
  },
  {
   "ini": 21.96,
   "fin": 22.96,
   "texto": "lo cual puede estar bien,"
  },
  {
   "ini": 22.96,
   "fin": 24.6,
   "texto": "pero para el futuro no tienes como"
  },
  {
   "ini": 24.6,
   "fin": 25.3,
   "texto": "un colchón,"
  },
  {
   "ini": 25.98,
   "fin": 27.68,
   "texto": "una protección, digamos."
  },
  {
   "ini": 27.68,
   "fin": 29.18,
   "texto": "Es que cuesta entender que si no"
  },
  {
   "ini": 29.18,
   "fin": 30.2,
   "texto": "tengo para alimentarme,"
  },
  {
   "ini": 30.2,
   "fin": 31.26,
   "texto": "para pagar la vivienda y para"
  },
  {
   "ini": 31.26,
   "fin": 32.92,
   "texto": "pagar la luz, ¿cómo voy a ahorrar?"
  },
  {
   "ini": 33.52,
   "fin": 34.98,
   "texto": "Eso es..."
  },
  {
   "ini": 34.98,
   "fin": 36.14,
   "texto": "estoy totalmente de acuerdo,"
  },
  {
   "ini": 37.42,
   "fin": 40.34,
   "texto": "pero a veces dentro de eso vas"
  },
  {
   "ini": 40.34,
   "fin": 43.2,
   "texto": "metiendo gastos que no deberías."
  }
 ]
}