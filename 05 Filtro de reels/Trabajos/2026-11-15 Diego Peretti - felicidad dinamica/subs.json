{
 "idioma": "es",
 "frases": [
  {
   "ini": 0.0,
   "fin": 2.96,
   "texto": "La felicidad no es un estado"
  },
  {
   "ini": 2.96,
   "fin": 4.02,
   "texto": "estático,"
  },
  {
   "ini": 4.82,
   "fin": 5.58,
   "texto": "es dinámico."
  },
  {
   "ini": 6.02,
   "fin": 7.08,
   "texto": "La felicidad, digamos,"
  },
  {
   "ini": 7.08,
   "fin": 8.04,
   "texto": "los estados de ánimo son"
  },
  {
   "ini": 8.04,
   "fin": 9.38,
   "texto": "dinámicos."
  },
  {
   "ini": 11.4,
   "fin": 13.76,
   "texto": "Y trato de ser consciente en los"
  },
  {
   "ini": 13.76,
   "fin": 15.14,
   "texto": "momentos de felicidad y me digo,"
  },
  {
   "ini": 15.14,
   "fin": 16.52,
   "texto": "en estos momentos estoy siendo"
  },
  {
   "ini": 16.52,
   "fin": 17.22,
   "texto": "feliz."
  },
  {
   "ini": 18.36,
   "fin": 20.2,
   "texto": "Lo quiero hacer consciente para"
  },
  {
   "ini": 20.2,
   "fin": 22.38,
   "texto": "después acordármelo, que hay"
  },
  {
   "ini": 22.38,
   "fin": 24.62,
   "texto": "momentos de felicidad."
  },
  {
   "ini": 24.62,
   "fin": 26.08,
   "texto": "Y cuando no estoy feliz,"
  },
  {
   "ini": 26.08,
   "fin": 29.24,
   "texto": "también lo llevo a consciente para"
  },
  {
   "ini": 29.24,
   "fin": 32.1,
   "texto": "que se impriman, que"
  },
  {
   "ini": 32.1,
   "fin": 34.86,
   "texto": "son estados de ánimo pasajeros."
  },
  {
   "ini": 36.54,
   "fin": 37.62,
   "texto": "Entonces, tengo momentos de"
  },
  {
   "ini": 37.62,
   "fin": 39.52,
   "texto": "felicidad, momentos muy felices,"
  },
  {
   "ini": 40.84,
   "fin": 41.6,
   "texto": "de gran placer,"
  },
  {
   "ini": 42.26,
   "fin": 45.48,
   "texto": "pero otros momentos en donde estoy"
  },
  {
   "ini": 45.48,
   "fin": 47.84,
   "texto": "muy, muy preocupado, angustiado."
  }
 ]
}