{
 "idioma": "es",
 "frases": [
  {
   "ini": 0.0,
   "fin": 2.5,
   "texto": "Yo era un tipo duro, a veces"
  },
  {
   "ini": 2.5,
   "fin": 3.24,
   "texto": "demasiado."
  },
  {
   "ini": 3.62,
   "fin": 5.48,
   "texto": "Yo era un tipo duro, pero era un"
  },
  {
   "ini": 5.48,
   "fin": 7.16,
   "texto": "tipo duro básicamente por tres"
  },
  {
   "ini": 7.16,
   "fin": 7.78,
   "texto": "razones."
  },
  {
   "ini": 7.78,
   "fin": 8.48,
   "texto": "La primera,"
  },
  {
   "ini": 9.42,
   "fin": 11.5,
   "texto": "porque el reto que nos propusimos"
  },
  {
   "ini": 11.5,
   "fin": 12.84,
   "texto": "era muy elevado."
  },
  {
   "ini": 13.4,
   "fin": 15.34,
   "texto": "Luego, no queda más remedio que"
  },
  {
   "ini": 15.34,
   "fin": 16.66,
   "texto": "asumir una cierta dureza,"
  },
  {
   "ini": 17.32,
   "fin": 18.92,
   "texto": "una gran dosis de exigencia."
  },
  {
   "ini": 20.3,
   "fin": 21.0,
   "texto": "Después,"
  },
  {
   "ini": 22.12,
   "fin": 24.22,
   "texto": "yo era duro porque vi a un chico"
  },
  {
   "ini": 24.22,
   "fin": 26.2,
   "texto": "que estuvo dispuesto a soportar"
  },
  {
   "ini": 26.2,
   "fin": 27.2,
   "texto": "esa dureza."
  },
  {
   "ini": 27.2,
   "fin": 28.64,
   "texto": "Y después, sobre todo,"
  },
  {
   "ini": 28.64,
   "fin": 30.32,
   "texto": "yo fui duro porque le tenía una"
  },
  {
   "ini": 30.32,
   "fin": 31.52,
   "texto": "gran estima."
  },
  {
   "ini": 31.52,
   "fin": 33.92,
   "texto": "Yo nunca sería duro con alguien"
  },
  {
   "ini": 33.92,
   "fin": 35.34,
   "texto": "por el que no siento un gran"
  },
  {
   "ini": 35.34,
   "fin": 36.7,
   "texto": "aprecio, una gran estima."
  },
  {
   "ini": 37.7,
   "fin": 39.44,
   "texto": "Yo cuando era el director de la"
  },
  {
   "ini": 39.44,
   "fin": 40.92,
   "texto": "academia de Rafael Nadal,"
  },
  {
   "ini": 41.3,
   "fin": 43.12,
   "texto": "yo le decía a los entrenadores sed"
  },
  {
   "ini": 43.12,
   "fin": 44.38,
   "texto": "muy exigentes,"
  },
  {
   "ini": 45.06,
   "fin": 46.68,
   "texto": "pero al mismo tiempo los chicos"
  },
  {
   "ini": 46.68,
   "fin": 48.64,
   "texto": "tienen que notar en vosotros"
  },
  {
   "ini": 48.64,
   "fin": 50.54,
   "texto": "vuestro aprecio, vuestra estima."
  }
 ]
}