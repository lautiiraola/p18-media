{
 "idioma": "es",
 "frases": [
  {
   "ini": 0.0,
   "fin": 1.46,
   "texto": "¿Qué pasa cuando vamos al gimnasio"
  },
  {
   "ini": 1.46,
   "fin": 2.48,
   "texto": "con regularidad?"
  },
  {
   "ini": 2.48,
   "fin": 3.82,
   "texto": "Al principio la fricción de las"
  },
  {
   "ini": 3.82,
   "fin": 5.16,
   "texto": "mancuernas y las barras generan"
  },
  {
   "ini": 5.16,
   "fin": 7.64,
   "texto": "dolor, ardor, pero cuando empezás"
  },
  {
   "ini": 7.64,
   "fin": 9.26,
   "texto": "a hacerlo más frecuentemente,"
  },
  {
   "ini": 9.26,
   "fin": 10.94,
   "texto": "las manos se forman callos."
  },
  {
   "ini": 10.94,
   "fin": 12.24,
   "texto": "Y ya no te vuelve a doler como"
  },
  {
   "ini": 12.24,
   "fin": 14.34,
   "texto": "antes, se vuelve tu nuevo estado"
  },
  {
   "ini": 14.34,
   "fin": 15.04,
   "texto": "normal."
  },
  {
   "ini": 15.28,
   "fin": 16.6,
   "texto": "Con la mente pasa lo mismo,"
  },
  {
   "ini": 16.6,
   "fin": 17.6,
   "texto": "y acá la importancia de"
  },
  {
   "ini": 17.6,
   "fin": 19.1,
   "texto": "someternos a situaciones incómodas"
  },
  {
   "ini": 19.1,
   "fin": 20.1,
   "texto": "todos los días."
  },
  {
   "ini": 20.1,
   "fin": 21.16,
   "texto": "Cuando nos enfrentamos con la"
  },
  {
   "ini": 21.16,
   "fin": 22.66,
   "texto": "incomodidad, cuando salimos de la"
  },
  {
   "ini": 22.66,
   "fin": 24.14,
   "texto": "zona de confort seguido,"
  },
  {
   "ini": 24.14,
   "fin": 25.28,
   "texto": "nuestra mente se endurece,"
  },
  {
   "ini": 25.28,
   "fin": 26.8,
   "texto": "se crean conexiones que antes no"
  },
  {
   "ini": 26.8,
   "fin": 27.2,
   "texto": "estaban ahí."
  },
  {
   "ini": 27.2,
   "fin": 29.12,
   "texto": "Ya el levantarte temprano se"
  },
  {
   "ini": 29.12,
   "fin": 30.1,
   "texto": "vuelve tu nuevo normal,"
  },
  {
   "ini": 30.62,
   "fin": 31.9,
   "texto": "el ir al gimnasio con frecuencia"
  },
  {
   "ini": 31.9,
   "fin": 33.08,
   "texto": "se vuelve tu nuevo normal,"
  },
  {
   "ini": 33.56,
   "fin": 35.12,
   "texto": "no tienen que ser cosas enormes,"
  },
  {
   "ini": 35.12,
   "fin": 36.44,
   "texto": "se tratan de microacciones"
  },
  {
   "ini": 36.44,
   "fin": 38.88,
   "texto": "incómodas a diario, desde tender"
  },
  {
   "ini": 38.88,
   "fin": 41.04,
   "texto": "la cama hasta lavar los platos,"
  },
  {
   "ini": 41.4,
   "fin": 42.76,
   "texto": "todo eso que odies hacer,"
  },
  {
   "ini": 42.76,
   "fin": 44.38,
   "texto": "hacelo, de esa manera encallecemos"
  },
  {
   "ini": 44.38,
   "fin": 46.2,
   "texto": "la mente, nos volvemos más fuertes"
  },
  {
   "ini": 46.2,
   "fin": 47.6,
   "texto": "y generamos un dialogo más"
  },
  {
   "ini": 47.6,
   "fin": 48.8,
   "texto": "productivo con nosotros mismos."
  }
 ]
}