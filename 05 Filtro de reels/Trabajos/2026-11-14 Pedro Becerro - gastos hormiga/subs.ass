Dialogue: 0,0:00:00.00,0:00:01.92,P18,,0,0,0,,Los gastos de hormigas,
Dialogue: 0,0:00:01.92,0:00:03.42,P18,,0,0,0,,eso es, a mí el concepto de gasto
Dialogue: 0,0:00:03.42,0:00:05.24,P18,,0,0,0,,de hormiga me encanta porque es,
Dialogue: 0,0:00:05.24,0:00:07.06,P18,,0,0,0,,oye es un gasto muy pequeñito,
Dialogue: 0,0:00:07.06,0:00:07.80,P18,,0,0,0,,tú no lo ves,
Dialogue: 0,0:00:08.66,0:00:10.48,P18,,0,0,0,,no eres consciente y cuando lo
Dialogue: 0,0:00:10.48,0:00:12.48,P18,,0,0,0,,sumas todo de repente es un gasto
Dialogue: 0,0:00:12.48,0:00:13.80,P18,,0,0,0,,muy grande, a mí me gusta poner el
Dialogue: 0,0:00:13.80,0:00:15.58,P18,,0,0,0,,ejemplo de tomarse un café
Dialogue: 0,0:00:16.26,0:00:17.00,P18,,0,0,0,,en un bar,
Dialogue: 0,0:00:17.62,0:00:19.34,P18,,0,0,0,,es un euro y medio, dos euros,
Dialogue: 0,0:00:19.34,0:00:21.64,P18,,0,0,0,,depende del sitio donde vayas,
Dialogue: 0,0:00:21.64,0:00:23.34,P18,,0,0,0,,ese euro y medio, esos dos euros,
Dialogue: 0,0:00:23.84,0:00:24.76,P18,,0,0,0,,son dos euros,
Dialogue: 0,0:00:25.36,0:00:27.36,P18,,0,0,0,,pero y si te lo tomas todos los
Dialogue: 0,0:00:27.36,0:00:28.06,P18,,0,0,0,,días del
Dialogue: 0,0:00:28.34,0:00:31.72,P18,,0,0,0,,son 500 euros el tabaco
Dialogue: 0,0:00:31.72,0:00:33.20,P18,,0,0,0,,si alguien está intentando dejar
Dialogue: 0,0:00:33.20,0:00:35.92,P18,,0,0,0,,de fumar si lo piensas desde el
Dialogue: 0,0:00:35.92,0:00:37.78,P18,,0,0,0,,punto de vista económico una
Dialogue: 0,0:00:37.78,0:00:39.58,P18,,0,0,0,,cajetilla de tabaco no sé cuánto
Dialogue: 0,0:00:39.58,0:00:41.56,P18,,0,0,0,,vale porque no fumo pero seis
Dialogue: 0,0:00:41.56,0:00:44.46,P18,,0,0,0,,siete euros oye si te compras
Dialogue: 0,0:00:44.46,0:00:46.72,P18,,0,0,0,,ocho cajetillas de tabaco al mes
Dialogue: 0,0:00:46.72,0:00:48.36,P18,,0,0,0,,son 50 euros también que se te
Dialogue: 0,0:00:48.36,0:00:50.28,P18,,0,0,0,,están yendo entonces esos pequeños
Dialogue: 0,0:00:50.28,0:00:51.76,P18,,0,0,0,,gastos que de por sí solos no
Dialogue: 0,0:00:51.76,0:00:53.08,P18,,0,0,0,,valen nada suman un montón
