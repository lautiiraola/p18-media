{
 "idioma": "es",
 "frases": [
  {
   "ini": 0.02,
   "fin": 2.26,
   "texto": "Me da vergüenza"
  },
  {
   "ini": 2.26,
   "fin": 5.36,
   "texto": "la desubicación, sobre todo,"
  },
  {
   "ini": 6.08,
   "fin": 7.56,
   "texto": "de algunas personas,"
  },
  {
   "ini": 8.82,
   "fin": 11.04,
   "texto": "la impunidad de no tener al otro"
  },
  {
   "ini": 11.04,
   "fin": 14.38,
   "texto": "en cuenta cuando se dice algo o se"
  },
  {
   "ini": 14.38,
   "fin": 15.7,
   "texto": "acciona de alguna manera,"
  },
  {
   "ini": 16.34,
   "fin": 18.06,
   "texto": "esa cosa muy egoísta."
  },
  {
   "ini": 21.02,
   "fin": 22.72,
   "texto": "Y a veces las personas eso lo"
  },
  {
   "ini": 22.72,
   "fin": 24.24,
   "texto": "hacen sin intencionalidad,"
  },
  {
   "ini": 24.24,
   "fin": 26.94,
   "texto": "pero cuando lo veo en alguna"
  },
  {
   "ini": 26.94,
   "fin": 29.32,
   "texto": "situación me provoca vergüenza"
  },
  {
   "ini": 29.32,
   "fin": 30.72,
   "texto": "ajena, vergüenza propia,"
  },
  {
   "ini": 31.22,
   "fin": 33.66,
   "texto": "cuando caigo en una situación así"
  },
  {
   "ini": 33.66,
   "fin": 35.68,
   "texto": "y no me doy cuenta."
  },
  {
   "ini": 41.02,
   "fin": 42.84,
   "texto": "Mucha impunidad en no tener en"
  },
  {
   "ini": 42.84,
   "fin": 44.42,
   "texto": "cuenta al otro, en cualquier"
  },
  {
   "ini": 44.42,
   "fin": 46.34,
   "texto": "situación eso me da, me causa"
  },
  {
   "ini": 46.34,
   "fin": 49.0,
   "texto": "vergüenza ajena y propia cuando me"
  },
  {
   "ini": 49.0,
   "fin": 49.7,
   "texto": "ocurre."
  }
 ]
