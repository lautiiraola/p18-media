  },
  {
   "ini": 18.28,
   "fin": 20.74,
   "texto": "Sí, las podés detectar."
  },
  {
   "ini": 21.14,
   "fin": 22.38,
   "texto": "Y te pueden detectar a vos"
  },
  {
   "ini": 22.38,
   "fin": 22.68,
   "texto": "también."
  },
  {
   "ini": 22.68,
   "fin": 23.9,
   "texto": "Y es muy lindo."
  },
  {
   "ini": 24.48,
   "fin": 26.46,
   "texto": "Cuando uno trabajó con un actor"
  },
  {
   "ini": 26.46,
   "fin": 29.74,
   "texto": "durante una temporada y después no"
  },
  {
   "ini": 29.74,
   "fin": 32.28,
   "texto": "lo ves durante siete años y te lo"
  },
  {
   "ini": 32.28,
   "fin": 33.88,
   "texto": "encontrás en un evento,"
  },
  {
   "ini": 33.88,
   "fin": 35.98,
   "texto": "a ese lo conocés, a esa persona"
  },
  {
   "ini": 35.98,
   "fin": 36.9,
   "texto": "la conocés."
  },
  {
   "ini": 36.9,
   "fin": 38.86,
   "texto": "Es como encontrarse con un amigo"
  },
  {
   "ini": 38.86,
   "fin": 39.9,
   "texto": "de la secundaria,"
  },
  {
   "ini": 40.58,
   "fin": 42.18,
   "texto": "y decir, lo conozco, pueden pasar"
  },
  {
