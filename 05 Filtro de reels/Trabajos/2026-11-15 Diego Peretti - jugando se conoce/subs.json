  },
  {
   "ini": 10.42,
   "fin": 12.04,
   "texto": "Esa es la palabra, a jugar."
  },
  {
   "ini": 12.04,
   "fin": 14.42,
   "texto": "Y en el juego, podés"
  },
  {
