{
 "idioma": "es",
 "frases": [
  {
   "ini": 0.0,
   "fin": 2.58,
   "texto": "Es que en la vida es un tema de"
  },
  {
   "ini": 2.58,
   "fin": 4.72,
   "texto": "renuncias, siempre no es un tema"
  },
  {
   "ini": 4.72,
   "fin": 7.04,
   "texto": "solo de hacer lo que yo quiero."
  },
  {
   "ini": 7.48,
   "fin": 9.46,
   "texto": "Tú tienes que renunciar."
  },
  {
   "ini": 10.56,
   "fin": 12.72,
   "texto": "A veces a la gente le compensa y a"
  },
  {
   "ini": 12.72,
   "fin": 13.42,
   "texto": "veces no."
  },
  {
   "ini": 14.18,
   "fin": 14.72,
   "texto": "¿Sabes?"
  },
  {
   "ini": 14.72,
   "fin": 17.54,
   "texto": "Si no te compensa, pues mejor que"
  },
  {
   "ini": 17.54,
   "fin": 19.5,
   "texto": "cambies de trabajo."
  },
  {
   "ini": 19.5,
   "fin": 22.58,
   "texto": "Espero que Alcaraz no lo cambie,"
  },
  {
   "ini": 22.58,
   "fin": 25.62,
   "texto": "evidentemente, porque es uno de"
  },
  {
   "ini": 25.62,
   "fin": 26.78,
   "texto": "los mejores del mundo."
  },
  {
   "ini": 26.78,
   "fin": 30.14,
   "texto": "Pero uno tiene que asumir,"
  },
  {
   "ini": 31.16,
   "fin": 33.58,
   "texto": "el reto tiene que asumir que lo"
  },
  {
   "ini": 33.58,
   "fin": 35.72,
   "texto": "que uno está haciendo en la vida"
  },
  {
   "ini": 35.72,
   "fin": 38.94,
   "texto": "va a"
  },
  {
   "ini": 38.94,
   "fin": 42.14,
   "texto": "comportar una serie de renuncias."
  },
  {
   "ini": 42.54,
   "fin": 44.08,
   "texto": "Yo no hablo de sacrificios,"
  },
  {
   "ini": 44.08,
   "fin": 46.5,
   "texto": "porque el sacrificio entiendo que"
  },
  {
   "ini": 46.5,
   "fin": 47.98,
   "texto": "es lo que tú haces por otro."
  },
  {
   "ini": 48.7,
   "fin": 50.68,
   "texto": "El sacrificio que hizo Jesucristo,"
  },
  {
   "ini": 50.68,
   "fin": 51.38,
   "texto": "teóricamente,"
  },
  {
   "ini": 52.64,
   "fin": 53.7,
   "texto": "lo hizo por otros."
  },
  {
   "ini": 53.7,
   "fin": 55.7,
   "texto": "Cuando tú lo haces por ti,"
  },
  {
   "ini": 56.34,
   "fin": 57.76,
   "texto": "es el precio que tienes que pagar."
  }
 ]
}