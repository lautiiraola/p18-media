{
 "idioma": "es",
 "frases": [
  {
   "ini": 0.0,
   "fin": 1.36,
   "texto": "Yo la hablo mucho con gente que"
  },
  {
   "ini": 1.36,
   "fin": 2.98,
   "texto": "es, no, pero no me quiero exponer,"
  },
  {
   "ini": 2.98,
   "fin": 3.68,
   "texto": "hacer videos."
  },
  {
   "ini": 4.0,
   "fin": 5.76,
   "texto": "Digo, si ese es tu problema,"
  },
  {
   "ini": 5.76,
   "fin": 6.22,
   "texto": "agradece."
  },
  {
   "ini": 6.22,
   "fin": 7.3,
   "texto": "Tienes el problema menos honesto"
  },
  {
   "ini": 7.3,
   "fin": 7.94,
   "texto": "de la historia."
  },
  {
   "ini": 7.94,
   "fin": 8.4,
   "texto": "Literal."
  },
  {
   "ini": 8.4,
   "fin": 9.84,
   "texto": "No sabes lo que hay gente que hace"
  },
  {
   "ini": 9.84,
   "fin": 10.74,
   "texto": "para ganar plata."
  },
  {
   "ini": 10.74,
   "fin": 11.94,
   "texto": "No, y además a la gente le da"
  },
  {
   "ini": 11.94,
   "fin": 14.7,
   "texto": "vergüenza que su círculo íntimo de"
  },
  {
   "ini": 14.7,
   "fin": 15.98,
   "texto": "amigos y familia y gente con la"
  },
  {
   "ini": 15.98,
   "fin": 17.26,
   "texto": "que trabaja lo juzguen."
  },
  {
   "ini": 17.26,
   "fin": 18.4,
   "texto": "Que ese grupo, como mucho,"
  },
  {
   "ini": 18.4,
   "fin": 19.58,
   "texto": "son 30 personas."
  },
  {
   "ini": 19.58,
   "fin": 20.28,
   "texto": "Como mucho."
  },
  {
   "ini": 20.62,
   "fin": 21.46,
   "texto": "Digo, vos a tu cumpleaños,"
  },
  {
   "ini": 21.46,
   "fin": 22.46,
   "texto": "cuánta gente invitas?"
  },
  {
   "ini": 22.46,
   "fin": 22.94,
   "texto": "30."
  },
  {
   "ini": 22.94,
   "fin": 23.64,
   "texto": "Ponele menos."
  },
  {
   "ini": 24.44,
   "fin": 25.7,
   "texto": "Esa es la gente que te importa."
  },
  {
   "ini": 26.4,
   "fin": 28.28,
   "texto": "Versus cientos de miles o incluso"
  },
  {
   "ini": 28.28,
   "fin": 29.66,
   "texto": "millones a los cuales podés"
  },
  {
   "ini": 29.66,
   "fin": 31.24,
   "texto": "contactar, que te conozcan y que"
  },
  {
   "ini": 31.24,
   "fin": 32.88,
   "texto": "eventualmente te compren."
  },
  {
   "ini": 32.88,
   "fin": 34.38,
   "texto": "Entonces uno deja de hacer algo"
  },
  {
   "ini": 34.38,
   "fin": 36.16,
   "texto": "sumamente redituable y rentable"
  },
  {
   "ini": 36.16,
   "fin": 38.14,
   "texto": "para tu compañía por la opinión de"
  },
  {
   "ini": 38.14,
   "fin": 38.96,
   "texto": "20 o 30."
  },
  {
   "ini": 38.96,
   "fin": 40.54,
   "texto": "No tiene sentido si lo pensás de"
  },
  {
   "ini": 40.54,
   "fin": 41.38,
   "texto": "forma racional."
  },
  {
   "ini": 42.3,
   "fin": 43.52,
   "texto": "A nivel emocional te puede dar"
  },
  {
   "ini": 43.52,
   "fin": 44.86,
   "texto": "vergüenza, pero en términos"
  },
  {
   "ini": 44.86,
   "fin": 46.66,
   "texto": "racionales no tiene sentido no"
  },
  {
   "ini": 46.66,
   "fin": 48.28,
   "texto": "hacerlo, ya que además hacerlo"
  },
  {
   "ini": 48.28,
   "fin": 50.34,
   "texto": "tiene un costo muy bajo."
  },
  {
   "ini": 50.34,
   "fin": 51.76,
   "texto": "Digo, la barrera de entrada que es"
  },
  {
   "ini": 51.76,
   "fin": 53.58,
   "texto": "tener un teléfono y"
  }
 ]
}